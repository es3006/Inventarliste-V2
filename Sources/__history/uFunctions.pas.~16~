function ParseExcelDate(const CellValue: OleVariant; const DefaultDate: TDateTime): TDateTime;
var
  FS: TFormatSettings;
begin
  FS := TFormatSettings.Create;
  FS.DateSeparator := '.';
  FS.ShortDateFormat := 'dd.MM.yyyy';

  try
    if VarIsNull(CellValue) or VarIsEmpty(CellValue) or (Trim(VarToStr(CellValue)) = '') then
      Result := DefaultDate
    else if VarIsNumeric(CellValue) then
      Result := CellValue // Excel speichert Datum als Zahl
    else
      Result := StrToDate(VarToStr(CellValue), FS);
  except
    Result := DefaultDate;
  end;
end;




