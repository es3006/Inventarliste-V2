procedure ClearLabeledEdits(AParent: TWinControl);
var
  i: Integer;
begin
  for i := 0 to AParent.ControlCount - 1 do
  begin
    if AParent.Controls[i] is TLabeledEdit then
      TLabeledEdit(AParent.Controls[i]).Clear
    else if AParent.Controls[i] is TWinControl then
      ClearLabeledEdits(TWinControl(AParent.Controls[i]));
  end;
end;



function HasInternet: Boolean;
begin
  try
    with TIdHTTP.Create(nil) do
    try
      ConnectTimeout := 2000;
      ReadTimeout := 2000;
      Head('https://www.google.com');
      Result := True;
    finally
      Free;
    end;
  except
    Result := False;
  end;
end;


function ISO8601ToDate(const S: string): TDate;
begin
  Result := StrToDateDef(S, 0); // JSON liefert yyyy-mm-dd → StrToDate mit passenden FormatSettings
end;





function VerifyLicenseOnline(const Email, Code, HWID: string): TDate;
var
  HTTP: TIdHTTP;
  SSL: TIdSSLIOHandlerSocketOpenSSL;
  Resp: string;
begin
  HTTP := TIdHTTP.Create(nil);
  SSL := TIdSSLIOHandlerSocketOpenSSL.Create(nil);
  try
    HTTP.IOHandler := SSL;
    Resp := HTTP.Get('https://deinserver/check_license.php?email=' +
                     TIdURI.ParamsEncode(Email) +
                     '&code=' + TIdURI.ParamsEncode(Code) +
                     '&hwid=' + HWID +
                     '&app=DEINAPP');
    if Resp.StartsWith('OK|') then
      Result := ISO8601ToDate(Copy(Resp, 4))
    else
      raise Exception.Create('Lizenz ungültig: ' + Resp);
  finally
    SSL.Free;
    HTTP.Free;
  end;
end;





function GetVolumeSerial: string;
var
  VolumeSerial: DWORD;
  Dummy1, Dummy2: DWORD;
  VolName, FSName: array[0..MAX_PATH] of Char;
begin
  if GetVolumeInformation('C:\', VolName, MAX_PATH,
    @VolumeSerial, Dummy1, Dummy2, FSName, MAX_PATH) then
    Result := IntToHex(VolumeSerial, 8)
  else
    Result := '00000000';
end;



function GetMacAddress: string;
var
  Adapter: TAdapterStatus;
  NCB: TNCB;
  LanaEnum: TLanaEnum;
  i: Integer;
begin
  Result := '';
  FillChar(NCB, SizeOf(NCB), 0);
  NCB.ncb_command := AnsiChar(NCBENUM);
  NCB.ncb_buffer := @LanaEnum;
  NCB.ncb_length := SizeOf(LanaEnum);

  if Netbios(@NCB) <> 0 then Exit;

  for i := 0 to Ord(LanaEnum.length) - 1 do
  begin
    FillChar(NCB, SizeOf(NCB), 0);
    NCB.ncb_command := AnsiChar(NCBRESET);
    NCB.ncb_lana_num := LanaEnum.lana[i];
    if Netbios(@NCB) <> 0 then Continue;

    FillChar(NCB, SizeOf(NCB), 0);
    NCB.ncb_command := AnsiChar(NCBASTAT);
    NCB.ncb_lana_num := LanaEnum.lana[i];
    AnsiStrings.StrPCopy(NCB.ncb_callname, '*');
    NCB.ncb_buffer := @Adapter;
    NCB.ncb_length := SizeOf(Adapter);

    if Netbios(@NCB) = 0 then
    begin
      Result := Format('%.2X-%.2X-%.2X-%.2X-%.2X-%.2X', [
        Byte(Adapter.adapter_address[0]),
        Byte(Adapter.adapter_address[1]),
        Byte(Adapter.adapter_address[2]),
        Byte(Adapter.adapter_address[3]),
        Byte(Adapter.adapter_address[4]),
        Byte(Adapter.adapter_address[5])
      ]);
      Exit;
    end;
  end;

  if Result = '' then
    Result := '00-00-00-00-00-00';
end;



