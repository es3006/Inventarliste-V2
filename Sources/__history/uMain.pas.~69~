procedure TfMain.acHinweisfensterExecute(Sender: TObject);
var
  ini: TIniFile;
begin
  SHOWHINWEISFENSTER := not SHOWHINWEISFENSTER;

  ini := TIniFile.Create(PATH + 'settings.ini');
  try
    ini.WriteBool('ANSICHT','ShowDownHintWindow',SHOWHINWEISFENSTER);
  finally
    ini.Free;
  end;

  tmHinweis.Enabled := SHOWHINWEISFENSTER;

  if(SHOWHINWEISFENSTER) then
  begin
    pnlHinweis.Height := 130;
  end
  else
