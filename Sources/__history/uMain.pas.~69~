procedure TfMain.LoadInventarToListView;
var
  Q: TFDQuery;
  Item: TListItem;
  SubItems: TStringList;
  Einkaufsdatum, Verkaufsdatum: string;
  Einkaufswert, Verkaufswert, Steuerbetrag: Int64;
begin
  lvInventar.Items.BeginUpdate;
  try
    lvInventar.Items.Clear;

    Q := TFDQuery.Create(nil);
    SubItems := TStringList.Create;
    try
      Q.Connection := FDConnection1;

      // Optimierte SQL: keine CASTs nötig
      Q.SQL.Text :=
        'SELECT id, Einkaufsdatum, Verkaufsdatum, SKU, Einkaufswert, EinkaufBemerkung, ' +
        'Verkaufswert, VerkaufBemerkung, Steuerbetrag, RechnungsNr, Einheit, AnkaufformularID ' +
        'FROM inventar ' +
        'ORDER BY id DESC';

      Q.Open;

      while not Q.Eof do
      begin
        Item := lvInventar.Items.Add;
        Item.Caption := Q.FieldByName('id').AsString;

        // SubItems sammeln
        SubItems.Clear;

        Einkaufsdatum := Q.FieldByName('Einkaufsdatum').AsString;
        Verkaufsdatum := Q.FieldByName('Verkaufsdatum').AsString;

        Einkaufswert := Q.FieldByName('Einkaufswert').AsLargeInt;
        Verkaufswert := Q.FieldByName('Verkaufswert').AsLargeInt;
        Steuerbetrag := Q.FieldByName('Steuerbetrag').AsLargeInt;

        SubItems.Add(SQLiteDateToDisplay(Einkaufsdatum));
        SubItems.Add(Q.FieldByName('SKU').AsString);
        SubItems.Add(Q.FieldByName('Einheit').AsString);
        SubItems.Add(Int100ToDecimalString(Einkaufswert));
        SubItems.Add(Q.FieldByName('EinkaufBemerkung').AsString);
        SubItems.Add(SQLiteDateToDisplay(Verkaufsdatum));

        // Verkaufswert (leeren String bei NULL)
        if (Q.FieldByName('Verkaufswert').IsNull) OR (Q.FieldByName('Verkaufswert').Text = '0') then
          SubItems.Add('')
        else
          SubItems.Add(Int100ToDecimalString(Verkaufswert));

        SubItems.Add(Q.FieldByName('VerkaufBemerkung').AsString);

        // Steuerbetrag (leeren String bei NULL)
        if (Q.FieldByName('Steuerbetrag').IsNull) OR (Q.FieldByName('Steuerbetrag').Text = '0') then
          SubItems.Add('')
        else
          SubItems.Add(Int100ToDecimalString(Steuerbetrag));

        SubItems.Add(Q.FieldByName('RechnungsNr').AsString);
        SubItems.Add(Q.FieldByName('AnkaufformularID').AsString);

        // Alle SubItems auf einmal hinzufügen
        Item.SubItems.AddStrings(SubItems);

        Q.Next;
      end;

    finally
      Q.Free;
      SubItems.Free;
    end;

  finally
    lvInventar.Items.EndUpdate;
  end;

  // Letzte Sortierung entfällt, SQL liefert bereits sortiert
  LastSorted := 1;
end;







