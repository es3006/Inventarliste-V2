    'Artikel löschen'+sLineBreak+'Rechtsklick -> Eintrag löschen'+sLineBreak+'Tastaturkürzel: Strg + Del'
  ];

  FHinweisIndex := 0;
  lbHinweis.Caption := FHinweise[FHinweisIndex];

