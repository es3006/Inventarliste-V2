procedure TfMain.LoadInventarToListViewBySuchbegriff(Spalte, Suchbegriff: string);
var
  Q: TFDQuery;
  Item: TListItem;
  DatumDT: TDateTime;
begin
  // ===== Eingaben prüfen =====
  if Spalte = '' then
  begin
    ShowMessage('Bitte Spalte auswählen');
    Exit;
  end;

  if Suchbegriff = '' then
  begin
    LoadInventarToListView;
    Exit;
  end;

  if not IsAllowedColumn(Spalte) then
  begin
    ShowMessage('Ungültige Spalte');
    Exit;
  end;

  lvInventar.Items.BeginUpdate;
  try
    lvInventar.Items.Clear;

    Q := TFDQuery.Create(nil);
    try
      Q.Connection := FDConnection1;
      Q.SQL.Text :=
        'SELECT id, ' +
        'CAST(Einkaufsdatum AS TEXT) AS Einkaufsdatum, ' +
        'CAST(Verkaufsdatum AS TEXT) AS Verkaufsdatum, ' +
        'SKU, Einheit, Einkaufswert, EinkaufBemerkung, ' +
        'Verkaufswert, VerkaufBemerkung, Steuerbetrag, RechnungsNr, AnkaufformularID ' +
        'FROM inventar ' +
        'WHERE ' + Spalte + ' LIKE :SUCHBEGRIFF || ''%'' ' +
        'ORDER BY Einkaufsdatum ASC';

      // ===== Parameter setzen =====
      if SameText(Spalte, 'Einkaufsdatum') or SameText(Spalte, 'Verkaufsdatum') then
      begin
        if TryStrToDate(Suchbegriff, DatumDT) then
          Q.ParamByName('SUCHBEGRIFF').AsString := DateTimeToSQLiteDate(DatumDT)
        else
        begin
          ShowMessage('Datum muss im Format TT.MM.JJJJ eingegeben werden');
          Exit;
        end;
      end
      else
        Q.ParamByName('SUCHBEGRIFF').AsString := Suchbegriff;

      Q.Open;

      // ===== Ergebnisse in ListView =====
      while not Q.Eof do
      begin
        Item := lvInventar.Items.Add;
        Item.Caption := Q.FieldByName('id').AsString;

        Item.SubItems.Add(SQLiteDateToDisplay(Q.FieldByName('Einkaufsdatum').AsString));
        Item.SubItems.Add(Q.FieldByName('SKU').AsString);
        Item.SubItems.Add(Q.FieldByName('Einheit').AsString);

        Item.SubItems.Add(Int100ToDecimalString(Q.FieldByName('Einkaufswert').AsLargeInt));
        Item.SubItems.Add(Q.FieldByName('EinkaufBemerkung').AsString);

        Item.SubItems.Add(SQLiteDateToDisplay(Q.FieldByName('Verkaufsdatum').AsString));
        Item.SubItems.Add(Int100ToDecimalString(Q.FieldByName('Verkaufswert').AsLargeInt));
        Item.SubItems.Add(Q.FieldByName('VerkaufBemerkung').AsString);

        Item.SubItems.Add(Int100ToDecimalString(Q.FieldByName('Steuerbetrag').AsLargeInt));
        Item.SubItems.Add(Q.FieldByName('RechnungsNr').AsString);
        Item.SubItems.Add(Q.FieldByName('AnkaufformularID').AsString);

        Q.Next;
      end;

    finally
      Q.Free;
    end;
  finally
    lvInventar.Items.EndUpdate;
  end;
end;







