    FIRMAIBAN     := ini.ReadString('FIRMA', 'FirmaIBAN', 'DE72 2060 0022 8620 49');

    // ===== Event temporär deaktivieren =====
    OldOnChange := cbSuchfeld.OnChange;
    cbSuchfeld.OnChange := nil;
    try
      cbSuchfeld.ItemIndex := ini.ReadInteger('SUCHE', 'SpaltenIndex', 0);
    finally
      cbSuchfeld.OnChange := OldOnChange;
    end;

    // ===== NICHT cbSuchfeldSelect aufrufen während FIsLoading! =====
    if not FIsLoading then
      cbSuchfeldSelect(nil);

    ColumnToSort := ini.ReadInteger('SORTIERUNG', 'Spalte', 1);
    if ini.ReadBool('SORTIERUNG', 'SortDirection', True) then
      SortDir := 1
    else
      SortDir := 0;

    SHOWHINWEISFENSTER := ini.ReadBool('ANSICHT', 'ShowDownHintWindow', True);
    SHOWEDELMETALLANVERKAUFWINDOW := ini.ReadBool('ANSICHT', 'showEdelmetallAnVerkaufWindow', False);
    cbShowEdelmetallAnVerkauf.Checked := SHOWEDELMETALLANVERKAUFWINDOW;
  finally
    ini.Free;
  end;

  LastSorted := 1;

  // ===== AlphaSort nur wenn nicht im Ladevorgang =====
  if not FIsLoading then
