procedure TfPreisabfrage.btnSelSelectedUnitsClick(Sender: TObject);
var
  i: Integer;
  Combo: TComboBox;
  Edit: TEdit;
  Index: Integer;
  Ausgabe: string;
begin
  SetLength(FEinh, 0); // Array leeren
  Index := 0;

  for i := 1 to 10 do
  begin
    Combo := FindComponent('cbEinheit' + IntToStr(i)) as TComboBox;
    Edit  := FindComponent('edEKPreis' + IntToStr(i)) as TEdit;

    if Assigned(Combo) and Assigned(Edit) then
    begin
      if (Trim(Edit.Text) <> '') and (Trim(Edit.Text).ToLower <> 'nicht vorhanden') then
      begin
        SetLength(FEinh, Index + 1);

        FEinh[Index].Einheit := Combo.Text;
        FEinh[Index].Einkaufswert := DecimalStringToInt100(Edit.Text);
        FEinh[Index].ID := Edit.Tag;  // ID aus Tag übernehmen

        // ID aus Tag übernehmen (muss beim Füllen der Edit-Felder gesetzt worden sein)
        // Wir erweitern den Record temporär für die Anzeige
        Inc(Index);
      end;
    end;
  end;

  // ====== Ausgabe ======
  Ausgabe := '';

  Ausgabe := '';
  for i := 0 to High(FEinh) do
  begin
    Ausgabe := Ausgabe +
      'ID: ' + IntToStr(FEinh[i].ID) +
      ' | Einheit: ' + FEinh[i].Einheit +
      ' | EK-Preis: ' + Int100ToDecimalString(FEinh[i].Einkaufswert) +
      sLineBreak;
  end;

  if Ausgabe = '' then
    ShowMessage('Keine gültigen Einträge ausgewählt.')
  else
    ShowMessage(Ausgabe);
end;






procedure TfPreisabfrage.cbEinheit1Select(Sender: TObject);
var
  Combo: TComboBox;
  Nummer: string;
  Edit: TEdit;
  Res: TEinheitPreis;
  i: Integer;
begin
  Combo := Sender as TComboBox;

  // Nummer aus dem Namen der ComboBox extrahieren (z.B. "1" aus "cbEinheit1")
  Nummer := Copy(Combo.Name, Length('cbEinheit') + 1, MaxInt);

  // Das zugehörige Edit-Feld finden
  Edit := FindComponent('edEKPreis' + Nummer) as TEdit;

  if Assigned(Edit) then
  begin
    if Trim(Combo.Text) = '' then
    begin
      // Leeres Item gewählt → Edit leeren, Tag = 0
      Edit.Text := '';
      Edit.Tag := 0;
    end
    else
    begin
      // DB-Abfrage: höchsten Einkaufswert + ID holen
      Res := LoadHighestPurchasePriceRecord(fMain.FDConnection1, Combo.Text);

      if Res.Einkaufswert > 0 then
      begin
        Edit.Text := Int100ToDecimalString(Res.Einkaufswert);
        Edit.Tag := Res.ID; // ID speichern
      end
      else
      begin
        Edit.Text := 'Nicht vorhanden';
        Edit.Tag := 0;
      end;
    end;
  end;
end;



