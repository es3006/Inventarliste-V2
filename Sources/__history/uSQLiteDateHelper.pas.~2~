unit uSQLiteDateHelper;

interface

uses
  System.SysUtils, System.DateUtils, VCL.ComCtrls, FireDAC.Comp.Client, FireDAC.Stan.Param;

{ Wandelt TDateTime in SQLite-Datumsstring yyyy-mm-dd }
function DateTimeToSQLiteDate(const ADate: TDateTime): string;

{ Wandelt SQLite-Datumsstring yyyy-mm-dd in TDateTime }
function SQLiteDateToDateTime(const AValue: string; out ADate: TDateTime): Boolean;

{ Gibt SQLite-Datum formatiert für Anzeige zurück (dd.mm.yyyy) }
function SQLiteDateToDisplay(const AValue: string): string;

{ Speichert Datum aus DateTimePicker in FireDAC-Parameter
  - Checked = True  -> yyyy-mm-dd
  - Checked = False -> NULL }
procedure SetSQLiteDateParam(const AParam: TFDParam; const ADTP: TDateTimePicker);

{ Lädt SQLite-Datum in DateTimePicker }
procedure LoadSQLiteDateToDTP(const AValue: string; const ADTP: TDateTimePicker);



implementation


{ Wandelt TDateTime in SQLite-Datumsstring yyyy-mm-dd }
function DateTimeToSQLiteDate(const ADate: TDateTime): string;
begin
  Result := FormatDateTime('yyyy-mm-dd', ADate);
end;


{ Wandelt SQLite-Datumsstring yyyy-mm-dd in TDateTime }
function SQLiteDateToDateTime(const AValue: string; out ADate: TDateTime): Boolean;
begin
  Result := False;

  if Trim(AValue) = '' then
    Exit;

  // yyyy-mm-dd -> TDateTime
  Result := TryISO8601ToDate(AValue, ADate, False);
end;



{ Gibt SQLite-Datum formatiert für Anzeige zurück (dd.mm.yyyy) }
function SQLiteDateToDisplay(const AValue: string): string;
var
  DT: TDateTime;
begin
  if SQLiteDateToDateTime(AValue, DT) then
    Result := FormatDateTime('dd.mm.yyyy', DT)
  else
    Result := '';
end;


{ Speichert Datum aus DateTimePicker in FireDAC-Parameter
  - Checked = True  -> yyyy-mm-dd
  - Checked = False -> NULL }
procedure SetSQLiteDateParam(const AParam: TFDParam; const ADTP: TDateTimePicker);
begin
  if ADTP.Checked then
    AParam.AsString := DateTimeToSQLiteDate(ADTP.Date)
  else
    AParam.Clear; // NULL in SQLite
end;


{ Lädt SQLite-Datum in DateTimePicker }
procedure LoadSQLiteDateToDTP(const AValue: string; const ADTP: TDateTimePicker);
var
  DT: TDateTime;
begin
  if SQLiteDateToDateTime(AValue, DT) then
  begin
    ADTP.Date := DT;
    ADTP.Checked := True;
  end
  else
  begin
    ADTP.Date := Now;
    ADTP.Checked := False;
  end;
end;

end.
