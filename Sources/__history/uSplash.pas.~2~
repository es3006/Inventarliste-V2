unit uSplash;

interface

uses
  System.SysUtils, System.Classes, Vcl.Forms, Vcl.StdCtrls, Vcl.ComCtrls,
  Vcl.Controls;

type
  TfSplash = class(TForm)
    lblStatus: TLabel;
    pbProgress: TProgressBar;
    Label1: TLabel;
  public
    procedure SetStatus(const AText: string; AProgress: Integer = -1);
  end;

var
  fSplash: TfSplash;

implementation

{$R *.dfm}

procedure TfSplash.SetStatus(const AText: string; AProgress: Integer = -1);
begin
  lblStatus.Caption := AText;
  if AProgress >= 0 then
    pbProgress.Position := AProgress;

  Application.ProcessMessages; // sorgt dafür, dass UI sofort aktualisiert wird
end;

end.

