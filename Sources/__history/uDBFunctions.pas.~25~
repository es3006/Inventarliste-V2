procedure ConvertInventarDatesToISO(const AConnection: TFDConnection);
begin
  // Einkaufsdatum
  AConnection.ExecSQL(
    'UPDATE inventar SET Einkaufsdatum = ' +
    'CASE ' +
    '  WHEN Einkaufsdatum IS NULL OR Trim(Einkaufsdatum) = '''' THEN NULL ' +
    '  WHEN typeof(Einkaufsdatum) = ''integer'' THEN ' +
    '    strftime(''%Y-%m-%d'', Einkaufsdatum, ''unixepoch'') ' +
    '  WHEN Einkaufsdatum GLOB ''[0-9][0-9].[0-9][0-9].[0-9][0-9][0-9][0-9]'' THEN ' +
    '    substr(Einkaufsdatum,7,4)||''-''||substr(Einkaufsdatum,4,2)||''-''||substr(Einkaufsdatum,1,2) ' +
    '  ELSE Einkaufsdatum ' +
    'END;'
  );

  // Verkaufsdatum
  AConnection.ExecSQL(
    'UPDATE inventar SET Verkaufsdatum = ' +
    'CASE ' +
    '  WHEN Verkaufsdatum IS NULL OR Trim(Verkaufsdatum) = '''' THEN NULL ' +
    '  WHEN typeof(Verkaufsdatum) = ''integer'' THEN ' +
    '    strftime(''%Y-%m-%d'', Verkaufsdatum, ''unixepoch'') ' +
    '  WHEN Verkaufsdatum GLOB ''[0-9][0-9].[0-9][0-9].[0-9][0-9][0-9][0-9]'' THEN ' +
    '    substr(Verkaufsdatum,7,4)||''-''||substr(Verkaufsdatum,4,2)||''-''||substr(Verkaufsdatum,1,2) ' +
    '  ELSE Verkaufsdatum ' +
    'END;'
  );
end;









//Die letzte SKU aus einer Tabelle ermitteln
//Übergabe des Tabellennamen und des zun suchenden Prefix (TG0000) oder (AK0000)
function GetLastSKUFromTable(const AConnection: TFDConnection;const Tabelle: string;const Prefix: string): string;
var
  Q: TFDQuery;
begin
  Result := '';

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := AConnection;
    Q.SQL.Text :=
      'SELECT MAX(CAST(SUBSTR(SKU, 3) AS INTEGER)) AS MaxSKU ' +
      'FROM ' + Tabelle + ' ' +
      'WHERE SKU LIKE :PFX';

    Q.ParamByName('PFX').AsString := Prefix + '%';
    Q.Open;

    if not Q.FieldByName('MaxSKU').IsNull then
      Result := Prefix + Format('%.6d', [Q.FieldByName('MaxSKU').AsInteger + 1])
    else
      Result := Prefix + '000001';
  finally
    Q.Free;
  end;
end;




function GetNextSKUFromTable(const AConnection: TFDConnection; const Tabelle: string; const Prefix: string; const Digits: Integer = 6): string;
var
  Q: TFDQuery;
  MaxNum: Integer;
  FormatStr: string;
begin
  Result := '';

  // Sicherheit: Prefix prüfen
  if Prefix = '' then
    raise Exception.Create('SKU-Prefix fehlt');

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := AConnection;

    Q.SQL.Text :=
      'SELECT MAX(CAST(SUBSTR(SKU, :StartPos) AS INTEGER)) AS MaxSKU ' +
      'FROM ' + Tabelle + ' ' +
      'WHERE SKU LIKE :PFX';

    // Startposition = Länge des Prefix + 1
    Q.ParamByName('StartPos').AsInteger := Length(Prefix) + 1;
    Q.ParamByName('PFX').AsString := Prefix + '%';

    Q.Open;

    if not Q.FieldByName('MaxSKU').IsNull then
      MaxNum := Q.FieldByName('MaxSKU').AsInteger + 1
    else
      MaxNum := 1;

    FormatStr := StringOfChar('0', Digits);
    Result := Prefix + FormatFloat(FormatStr, MaxNum);
  finally
    Q.Free;
  end;
end;



function GetLastKdNr(const AConnection: TFDConnection): string;
var
  Q: TFDQuery;
  MaxNum: Integer;
begin
  Result := STARTKUNDENNR;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := AConnection;
    Q.SQL.Text :=
      'SELECT MAX(CAST(SUBSTR(KundenNr, 3) AS INTEGER)) AS MaxKdNr ' +
      'FROM kundendaten ' +
      'WHERE KundenNr LIKE ''KD%''';

    Q.Open;

    if not Q.FieldByName('MaxKdNr').IsNull then
    begin
      MaxNum := Q.FieldByName('MaxKdNr').AsInteger;
      Result := Format('%.6d', [MaxNum]);
    end
    else
    begin
      // Falls noch kein Eintrag existiert
      Result := STARTKUNDENNR;
    end;

  finally
    Q.Free;
  end;
end;



function GetNextKdNr(const AConnection: TFDConnection): string;
var
  Q: TFDQuery;
  MaxNum: Integer;
begin
  Q := TFDQuery.Create(nil);
  try
    Q.Connection := AConnection;
    Q.SQL.Text :=
      'SELECT MAX(CAST(SUBSTR(KundenNr, 6) AS INTEGER)) ' +
      'FROM kundendaten WHERE KundenNr LIKE ''%''';
    Q.Open;

    if Q.Fields[0].IsNull then
      MaxNum := 0
    else
      MaxNum := Q.Fields[0].AsInteger;

    Inc(MaxNum); // **einmal erhöhen, garantiert korrekt**

    Result := 'KD' + Format('%.6d', [MaxNum]);
  finally
    Q.Free;
  end;
end;








