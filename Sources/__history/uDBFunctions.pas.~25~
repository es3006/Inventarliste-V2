function GetCountStatistik( const Connection: TFDConnection; const ATableName: string; const AFieldName: string; const NurHeute: Boolean): Integer;
var
  Q: TFDQuery;
  Heute: string;
begin
  Result := 0;

  if (ATableName = '') or (AFieldName = '') then
    Exit;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := Connection;

    if NurHeute then
    begin
      // 🔹 Datum über deine Helper-Unit
      Heute := DateTimeToSQLiteDate(Date);

      Q.SQL.Text :=
        'SELECT COUNT(*) AS CNT FROM ' + ATableName +
        ' WHERE ' + AFieldName + ' = :DATUM';

      Q.ParamByName('DATUM').AsString := Heute;
    end
    else
    begin
      Q.SQL.Text :=
        'SELECT COUNT(*) AS CNT FROM ' + ATableName +
        ' WHERE ' + AFieldName + ' IS NOT NULL';
    end;

    Q.Open;

    if not Q.FieldByName('CNT').IsNull then
      Result := Q.FieldByName('CNT').AsInteger;

  finally
    Q.Free;
  end;
end;




