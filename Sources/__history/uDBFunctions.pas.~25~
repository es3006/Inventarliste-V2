function ColumnExists(AConnection: TFDConnection; const ATableName, AColumnName: string): Boolean;
var
  Q: TFDQuery;
begin
  Result := False;
  Q := TFDQuery.Create(nil);
  try
    Q.Connection := AConnection;
    Q.SQL.Text := Format('PRAGMA table_info(%s)', [ATableName]);
    Q.Open;
    while not Q.Eof do
    begin
      if SameText(Q.FieldByName('name').AsString, AColumnName) then
      begin
        Result := True;
        Exit;
      end;
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;



// Hilfsfunktion zum Parsen von CSV-Zeilen mit Anführungszeichen und Trennzeichen
// Verbesserte Hilfsfunktion zum Parsen von CSV-Zeilen
function ParseCSVLine(const ALine: string; const ADelimiter: Char): TArray<string>;
var
  InQuotes: Boolean;
  CurrentField: string;
  i: Integer;
  Ch: Char;
  Fields: TList<string>;
begin
  Fields := TList<string>.Create;
  try
    InQuotes := False;
    CurrentField := '';

    for i := 1 to Length(ALine) do
    begin
      Ch := ALine[i];

      if Ch = '"' then
      begin
        InQuotes := not InQuotes;
        // Anführungszeichen NICHT zum Feld hinzufügen
      end
      else if (Ch = ADelimiter) and (not InQuotes) then
      begin
        Fields.Add(Trim(CurrentField)); // Trim hinzugefügt
        CurrentField := '';
      end
      else
      begin
        CurrentField := CurrentField + Ch;
      end;
    end;

    // Letztes Feld hinzufügen
    Fields.Add(Trim(CurrentField)); // Trim hinzugefügt

    // TList in TArray konvertieren
    SetLength(Result, Fields.Count);
    for i := 0 to Fields.Count - 1 do
      Result[i] := Fields[i];

  finally
    Fields.Free;
  end;
end;



